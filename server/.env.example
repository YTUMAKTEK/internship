# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/internship

# Long random secrets - generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
EMAIL_TOKEN_SECRET=change-me-too

# Resend (https://resend.com) API key and verified sender address
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=noreply@mail.yourdomain.com

# Public base URL the server is reachable at (used to build the verification link)
APP_BASE_URL=http://localhost:3000

PORT=3000
